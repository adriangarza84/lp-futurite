---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Metricas from '../components/Metricas.astro';
import Problema from '../components/Problema.astro';
import Motores from '../components/Motores.astro';
import Diferenciador from '../components/Diferenciador.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Contexto from '../components/Contexto.astro';
import Proceso from '../components/Proceso.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
---

<Layout>
  <Header />

  <main id="contenido">
    <Hero />
    <Metricas />
    <Motores />
    <Problema />
    <Diferenciador />
    <PruebaSocial />
    <Contexto />
    <Proceso />
    <CtaFinal />
  </main>

  <Footer />
  <WhatsappFab />
</Layout>
