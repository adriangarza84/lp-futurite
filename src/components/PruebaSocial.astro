---
import { marcas } from '../data/site.js';

// La cinta se duplica para que el bucle no tenga corte visible
const cinta = [...marcas, ...marcas];
---

<section class="seccion clientes" id="clientes">
  <div class="contenedor">
    <header class="cabecera">
      <p class="ante reveal">Prueba social</p>
      <h2 class="h2 reveal" style="--d:80ms">
        Más de 90 marcas líderes<br />
        <span class="acento">ya confían en Futurité.</span>
      </h2>
    </header>
  </div>

  <!-- Marquesina de logos: movimiento constante, se detiene al pasar el cursor -->
  <div class="cinta reveal" style="--d:140ms">
    <div class="pista" data-pista>
      {
        cinta.map((m, i) => (
          <span class="marca" aria-hidden={i >= marcas.length ? 'true' : null}>
            {m}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cabecera {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* --- Marquesina --- */

  .cinta {
    overflow: hidden;
    padding-block: 1.5rem;
    border-block: 1px solid var(--borde);
    /* Difumina los extremos para que entren y salgan sin corte */
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  .pista {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    width: max-content;
    animation: correr 42s linear infinite;
  }

  .cinta:hover .pista {
    animation-play-state: paused;
  }

  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  .marca {
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.42);
    transition:
      color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .marca:hover {
    color: #fff;
    transform: scale(1.06);
  }

</style>
