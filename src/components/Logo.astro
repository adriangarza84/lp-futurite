---
// Isotipo Futurité — vectorizado del archivo oficial
// (futurite.mx/assets/logo_futurite_ch.png).
//
// Son cuatro chevrones de 45°, mismo grosor (17.68) y esquinas redondeadas:
// dos claros arriba y abajo formando el rombo, dos oscuros a los lados
// apuntando al centro. Los brazos se cortan a escuadra contra el borde de
// la caja, igual que en el original.

const TONOS = {
  blanco: { fuerte: '#ffffff', suave: 'rgba(255,255,255,.55)' },
  marca: { fuerte: '#2d4ee6', suave: '#7d90eb' },
  navy: { fuerte: '#0a1330', suave: 'rgba(10,19,48,.5)' },
  lima: { fuerte: '#c3f53c', suave: 'rgba(195,245,60,.5)' },
};

const {
  alto = 34,
  soloIso = false,
  tono = 'blanco',
  fuerte = TONOS[tono].fuerte,
  suave = TONOS[tono].suave,
} = Astro.props;
---

<span class="logo" style={`--alto:${alto}px`}>
  <svg
    class="iso"
    viewBox="0 0 87 137"
    fill="none"
    stroke-width="17.68"
    stroke-linejoin="round"
    aria-hidden="true"
    role="presentation"
  >
    <path
      d="M-.75 48.75 36.3 11.7A9.5 9.5 0 0 1 49.7 11.7L86.75 48.75"
      stroke={suave}></path>
    <path
      d="M-.75 87.25 36.3 124.3A9.5 9.5 0 0 0 49.7 124.3L86.75 87.25"
      stroke={suave}></path>
    <path
      d="M-.75 36.75 23.7 61.2A9.66 9.66 0 0 1 23.7 74.8L-.75 99.25"
      stroke={fuerte}></path>
    <path
      d="M86.75 36.75 62.3 61.2A9.66 9.66 0 0 0 62.3 74.8L86.75 99.25"
      stroke={fuerte}></path>
  </svg>

  {!soloIso && <span class="palabra" style={`color:${fuerte}`}>Futurité</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    /* Proporciones tomadas del logo oficial: separación y cuerpo de texto
       relativos al alto del isotipo. */
    gap: calc(var(--alto) * 0.16);
    height: var(--alto);
  }

  .iso {
    height: 100%;
    width: auto;
    aspect-ratio: 87 / 137;
    overflow: hidden;
  }

  .palabra {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: calc(var(--alto) * 0.78);
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
