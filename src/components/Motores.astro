---
import Icono from './Icono.astro';
import IconoWhatsapp from './IconoWhatsapp.astro';
import { motores, waLink } from '../data/site.js';
---

<section class="seccion motores" id="motores">
  <div class="glow glow-lima g"></div>

  <div class="contenedor">
    <header class="cabecera">
      <p class="ante reveal">Nuestros 3 motores de venta</p>
      <h2 class="h2 reveal" style="--d:80ms">
        Servicios que<br />
        <span class="acento">Generan conversiones</span>
      </h2>
    </header>

    <!-- Bento: 7 / 5 arriba, ancho completo abajo -->
    <div class="bento">
      {
        motores.map((m, i) => (
          <article class="card motor reveal" id={m.id} style={`--d:${i * 110}ms`}>
            <span class="num">0{i + 1}</span>

            <div class="cuerpo">
              <div class="icono">
                <Icono nombre={m.icono} tam={27} />
              </div>

              <h3 class="h3">{m.titulo}</h3>
              <p class="desc">{m.texto}</p>
              <p class="remate">{m.remate}</p>

              <ul class="chips">
                {m.chips.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>

            <a
              class="enlace"
              href={waLink(m.consulta)}
              target="_blank"
              rel="noopener"
            >
              Quiero este motor
              <Icono nombre="flecha" tam={17} />
            </a>
          </article>
        ))
      }
    </div>

    <div class="pie reveal">
      <a class="btn btn-lima" href={waLink()} target="_blank" rel="noopener">
        <IconoWhatsapp tam={20} />
        Quiero una estrategia para mi negocio
      </a>
    </div>
  </div>
</section>

<style>
  .motores {
    overflow: hidden;
  }

  .g {
    width: 40rem;
    height: 30rem;
    top: -6rem;
    right: -16rem;
  }

  .cabecera {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .bento {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .motor {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
  }

  .num {
    position: absolute;
    top: clamp(1.4rem, 3vw, 2rem);
    right: clamp(1.4rem, 3vw, 2rem);
    font-family: var(--f-display);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.07);
    transition: color 0.5s var(--ease);
  }

  .motor:hover .num {
    color: rgba(195, 245, 60, 0.28);
  }

  .cuerpo {
    flex: 1;
  }

  .h3 {
    margin-bottom: 0.85rem;
    max-width: 22ch;
  }

  .desc {
    color: var(--txt-2);
    margin-bottom: 1rem;
    max-width: 52ch;
  }

  .remate {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--lima);
    letter-spacing: -0.015em;
    max-width: 40ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .chips li {
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--borde);
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--txt-3);
    transition:
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .motor:hover .chips li {
    border-color: rgba(195, 245, 60, 0.3);
    color: var(--txt-2);
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--borde);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--txt-2);
    transition:
      color 0.35s var(--ease),
      gap 0.35s var(--ease);
  }

  .enlace:hover {
    color: var(--lima);
    gap: 0.85rem;
  }

  .pie {
    position: relative;
    z-index: 1;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .motor:nth-child(1) {
      grid-column: span 7;
    }

    .motor:nth-child(2) {
      grid-column: span 5;
    }

    /* El tercero ocupa el ancho completo y cambia a dos columnas */
    .motor:nth-child(3) {
      grid-column: span 12;
      flex-direction: row;
      align-items: flex-end;
      gap: clamp(2rem, 5vw, 4rem);
    }

    .motor:nth-child(3) .cuerpo {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    .motor:nth-child(3) .icono {
      grid-area: 1 / 1;
    }

    .motor:nth-child(3) .h3 {
      grid-area: 2 / 1;
      align-self: end;
    }

    .motor:nth-child(3) .desc {
      grid-area: 1 / 2 / 3 / 3;
      margin-bottom: 0;
    }

    .motor:nth-child(3) .remate {
      grid-area: 3 / 2;
      margin-top: 1rem;
    }

    .motor:nth-child(3) .chips {
      grid-area: 4 / 1 / 5 / -1;
      margin-top: 1.75rem;
    }

    .motor:nth-child(3) .enlace {
      flex: none;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
      padding-bottom: 0.4rem;
    }
  }
</style>
