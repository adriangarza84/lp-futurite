---
import Icono from './Icono.astro';
import { diferenciadores } from '../data/site.js';
---

<!-- Sección "respiro" en lima: rompe el dark mode como en el feed de la marca -->
<section class="seccion tema-lima dif" id="diferenciador">
  <div class="contenedor">
    <header class="cabecera">
      <p class="ante reveal">Por qué nosotros</p>
      <h2 class="h2 reveal" style="--d:80ms">
        Somos especialistas en<br />
        <span class="acento">Marketing Performance.</span>
      </h2>
      <p class="plomo reveal" style="--d:150ms">
        Aquí no se trata de hacer campañas bonitas. Se trata de resultados
        medibles.
      </p>
    </header>

    <div class="bento">
      {
        diferenciadores.map((d, i) => (
          <article
            class:list={['card pieza reveal', { destacado: d.destacado }]}
            style={`--d:${i * 100}ms`}
          >
            <div class="icono">
              <Icono nombre={d.icono} tam={27} />
            </div>

            <h3 class="h3">{d.titulo}</h3>
            <p>{d.texto}</p>

            {d.destacado && (
              <div class="senal" aria-hidden="true">
                <span /> <span /> <span /> <span /> <span /> <span /> <span />
                <span /> <span /> <span /> <span /> <span />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cabecera {
    max-width: 48rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .cabecera .plomo {
    margin-top: 1.4rem;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .pieza {
    grid-column: span 12;
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(10, 19, 48, 0.08);
    display: flex;
    flex-direction: column;
  }

  .pieza:hover {
    background: #fff;
  }

  .pieza .h3 {
    margin-bottom: 0.6rem;
  }

  .pieza p {
    color: var(--txt-2);
    max-width: 40ch;
  }

  /* --- Señal en vivo del bloque de monitoreo --- */

  .senal {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 74px;
    margin-top: auto;
    padding-top: 2rem;
  }

  .senal span {
    flex: 1;
    max-width: 12px;
    border-radius: 3px;
    background: var(--azul);
    opacity: 0.4;
    animation: senal 1.5s ease-in-out infinite;
  }

  .senal span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .senal span:nth-child(2) { height: 70%; animation-delay: 0.1s; }
  .senal span:nth-child(3) { height: 30%; animation-delay: 0.2s; }
  .senal span:nth-child(4) { height: 85%; animation-delay: 0.3s; }
  .senal span:nth-child(5) { height: 55%; animation-delay: 0.4s; }
  .senal span:nth-child(6) { height: 100%; animation-delay: 0.5s; }
  .senal span:nth-child(7) { height: 45%; animation-delay: 0.6s; }
  .senal span:nth-child(8) { height: 75%; animation-delay: 0.7s; }
  .senal span:nth-child(9) { height: 35%; animation-delay: 0.8s; }
  .senal span:nth-child(10) { height: 90%; animation-delay: 0.9s; }
  .senal span:nth-child(11) { height: 50%; animation-delay: 1s; }
  .senal span:nth-child(12) { height: 65%; animation-delay: 1.1s; }

  @keyframes senal {
    0%,
    100% {
      transform: scaleY(0.55);
      opacity: 0.28;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.9;
    }
  }

  .senal span {
    transform-origin: bottom;
  }

  @media (min-width: 860px) {
    .pieza:nth-child(1) {
      grid-column: span 7;
    }
    .pieza:nth-child(2) {
      grid-column: span 5;
    }
    .pieza:nth-child(3) {
      grid-column: span 5;
    }
    .pieza:nth-child(4) {
      grid-column: span 7;
    }
  }
</style>
