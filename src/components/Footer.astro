---
import Logo from './Logo.astro';
import { site } from '../data/site.js';

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <div class="alto">
      <div class="col marca-col">
        <Logo alto={32} color="#ffffff" colorRombo="rgba(111,141,255,.5)" />
        <p class="descriptor">
          Agencia de Marketing Digital de Alto Rendimiento
        </p>

        <div class="sellos">
          <span>Meta Business Partner</span>
          <span>Google Partner Premier 2026</span>
        </div>
      </div>

      <div class="col">
        <p class="rotulo">Contacto</p>
        <address>
          <p>{site.direccion}</p>
          <p>
            <a href={`tel:${site.telefonoSedeRaw}`}>{site.telefonoSede}</a>
          </p>
          <p>
            <a href={`mailto:${site.correo}`}>{site.correo}</a>
          </p>
          <p>
            WhatsApp de ventas:
            <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
              {site.whatsappVisible}
            </a>
          </p>
        </address>
      </div>

      <div class="col">
        <p class="rotulo">Presencia</p>
        <ul class="lista">
          {site.ciudades.map((c) => <li>{c}</li>)}
        </ul>

        <p class="rotulo redes-rotulo">Síguenos</p>
        <ul class="redes">
          {
            site.redes.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener">
                  {r.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="bajo">
      <p>© {anio} {site.nombre}. Todos los derechos reservados.</p>
      <p class="legales">
        <a href={site.avisoPrivacidad} target="_blank" rel="noopener">
          Aviso de privacidad
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: #04081a;
    border-top: 1px solid var(--borde);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }

  .alto {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .descriptor {
    margin-top: 1.1rem;
    color: var(--txt-3);
    font-size: 0.92rem;
    max-width: 28ch;
  }

  .sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .sellos span {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--borde);
    font-size: 0.74rem;
    color: var(--txt-3);
  }

  .rotulo {
    font-family: var(--f-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lima);
    margin-bottom: 1rem;
  }

  .redes-rotulo {
    margin-top: 1.8rem;
  }

  address {
    font-style: normal;
    display: grid;
    gap: 0.6rem;
    color: var(--txt-2);
    font-size: 0.92rem;
    max-width: 32ch;
  }

  address a,
  .redes a {
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  address a:hover,
  .redes a:hover {
    color: var(--lima);
    border-bottom-color: currentColor;
  }

  .lista,
  .redes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    color: var(--txt-2);
    font-size: 0.92rem;
  }

  .bajo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--borde);
    font-size: 0.82rem;
    color: var(--txt-3);
  }

  .legales a:hover {
    color: var(--lima);
  }

  @media (min-width: 800px) {
    .alto {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
</style>
