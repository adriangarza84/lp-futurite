---
// Set de iconos propio. Trazo lineal de alto contraste, 24x24, sin relleno.
// Cada símbolo está elegido para su bloque, no es genérico.
const { nombre, tam = 26 } = Astro.props;

const trazos = {
  // Google Ads — embudo de conversión con flujo
  embudo: `<path d="M3.2 4.5h17.6a.8.8 0 0 1 .62 1.3L14.9 13.2v5.4a.8.8 0 0 1-.44.72l-3.2 1.6a.8.8 0 0 1-1.16-.72V13.2L2.58 5.8a.8.8 0 0 1 .62-1.3Z"/><path d="M8.4 8.6h7.2"/>`,

  // Redes Sociales — diana de segmentación con cursor de clic
  objetivo: `<circle cx="10.6" cy="10.6" r="7.4"/><circle cx="10.6" cy="10.6" r="3.3"/><path d="m13.9 13.9 7.3 2.7-3.2 1.1-1.1 3.2-3-7Z"/>`,

  // SEO + GEO — lupa con destello generativo
  radar: `<circle cx="10.5" cy="10.5" r="6.9"/><path d="m15.6 15.6 5.2 5.2"/><path d="m10.5 6.9 1 2.6 2.6 1-2.6 1-1 2.6-1-2.6-2.6-1 2.6-1 1-2.6Z"/>`,

  // Monitoreo — pantalla con señal en vivo
  monitor: `<rect x="2.2" y="4" width="19.6" height="13.6" rx="2.4"/><path d="M6.2 11.4h2.6l1.8-3.4 2.5 6.2 1.7-2.8h2.9"/><path d="M9 21h6M12 17.6V21"/>`,

  // Dashboards — tablero con barras
  tablero: `<rect x="2.6" y="3.4" width="18.8" height="17.2" rx="2.4"/><path d="M2.6 8.4h18.8"/><path d="M7.2 17v-3.6M11.9 17v-5.6M16.6 17v-2.2"/>`,

  // IA — chip con núcleo
  chip: `<rect x="6.4" y="6.4" width="11.2" height="11.2" rx="2"/><rect x="10.1" y="10.1" width="3.8" height="3.8" rx="1"/><path d="M9.6 3v3.4M14.4 3v3.4M9.6 17.6V21M14.4 17.6V21M3 9.6h3.4M3 14.4h3.4M17.6 9.6H21M17.6 14.4H21"/>`,

  // Aliados de negocio — curva de ROI que rompe el marco
  roi: `<path d="M3 17.4l5.4-5.4 3.4 3.4L21 6.8"/><path d="M15.4 6.8H21v5.6"/><circle cx="8.4" cy="12" r="1.3"/><circle cx="11.8" cy="15.4" r="1.3"/>`,

  // Proceso — chat de arranque
  chat: `<path d="M20.6 12.2a8 8 0 0 1-8.6 8 9 9 0 0 1-3.6-.8L3.4 21l1.6-4.8a8 8 0 0 1-1-4A8 8 0 0 1 12.2 4.2a8 8 0 0 1 8.4 8Z"/><path d="M9 12h.01M12.4 12h.01M15.8 12h.01"/>`,

  // Proceso — diagnóstico
  lupa: `<circle cx="10.8" cy="10.8" r="6.8"/><path d="m15.8 15.8 5 5"/><path d="M8.4 11.6h1.8l1.2-2.4 1.6 4 1.1-2.2h1.4"/>`,

  // Proceso — estrategia a la medida
  ruta: `<path d="M6.5 3.4v10.4M17.5 10.2V20.6"/><circle cx="6.5" cy="17.3" r="3.3"/><circle cx="17.5" cy="6.7" r="3.3"/>`,

  // Proceso — ejecución medida
  cohete: `<path d="M13.6 3.6c3.2 1 6 3.8 7 7L14.2 17a7.4 7.4 0 0 0-7.4-7.4l6.8-6Z"/><path d="M6.8 9.6 4 12.4l3 .6.6 3 2.8-2.8"/><path d="M6 18a3.4 3.4 0 0 1 0 3.4 3.4 3.4 0 0 1-3.4 0A3.4 3.4 0 0 1 6 18Z"/>`,

  // Flecha de avance
  flecha: `<path d="M4.5 12h15"/><path d="m13.2 5.8 6.3 6.2-6.3 6.2"/>`,

  // Alerta del bloque de problema
  alerta: `<path d="M10.3 3.9 2.5 17.3a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9.4v4.2M12 17.2h.01"/>`,
};

const d = trazos[nombre] ?? trazos.flecha;
---

<svg
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  role="presentation"
  set:html={d}
/>
